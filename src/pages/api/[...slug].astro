---
import { render } from "astro:content";
import ApiLayout from "@/layouts/ApiLayout.astro";
import { docsComponents } from "@/components/docs";
import { getEndpoints, apiHref } from "@/lib/api";
import { toMarkdown } from "@/lib/api-markdown";

export async function getStaticPaths() {
  const endpoints = await getEndpoints();
  return endpoints.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, previous: endpoints[index - 1], next: endpoints[index + 1] },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
const link = (item?: typeof entry) => (item ? { title: item.data.title, description: item.data.description, href: apiHref(item.id) } : undefined);
---

<ApiLayout
  frontmatter={entry.data}
  headings={headings}
  markdown={toMarkdown(entry)}
  markdownHref={`${apiHref(entry.id)}.md`}
  previous={link(previous)}
  next={link(next)}
>
  <Content components={docsComponents} />
</ApiLayout>
