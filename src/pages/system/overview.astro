---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const pageSections = [
  {
    title: "Static",
    columns: [
      {
        category: "Pages",
        links: [
          { text: "Home", href: "/" },
          { text: "Status", href: "/status" },
          { text: "404", href: "/404" },
        ],
      },
      {
        category: "System",
        links: [
          { text: "Colors", href: "/system/colors" },
          { text: "Links", href: "/system/link" },
          { text: "Buttons", href: "/system/buttons" },
          { text: "Typography", href: "/system/typography" },
        ],
      },
      {
        category: "Resources",
        links: [
          { text: "License", href: "https://lexingtonthemes.com/legal/license" },
          { text: "Documentation", href: "https://lexingtonthemes.com/documentation" },
        ],
      },
    ],
  },
  {
    title: "Content collections",
    columns: [
      {
        category: "Docs",
        links: [
          { text: "Index", href: "/docs" },
          { text: "Page", href: "/docs/getting-started/quickstart" },
          { text: "Page as Markdown", href: "/docs/getting-started/quickstart.md" },
        ],
      },
      {
        category: "API reference",
        links: [
          { text: "Index", href: "/api" },
          { text: "Endpoint", href: "/api/search" },
          { text: "Endpoint as Markdown", href: "/api/search.md" },
        ],
      },
      {
        category: "SDKs",
        links: [
          { text: "Index", href: "/sdks" },
          { text: "SDK", href: "/sdks/javascript" },
        ],
      },
      {
        category: "Changelog",
        links: [
          { text: "Index", href: "/changelog" },
          { text: "Release", href: "/changelog/swap-indexes" },
        ],
      },
    ],
  },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12 lg:py-24">
      <Text tag="h2" variant="displaySM" class="font-medium text-foreground">
        Overview
      </Text>
      <div class="flex flex-col mt-12 gap-12">
        {
          pageSections.map((section) => (
            <div>
              <Text
                tag="h3"
                variant="textBase"
                class="font-medium text-foreground"
              >
                {section.title}
              </Text>
              <div class="mt-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 xl:grid-cols-4">
                {section.columns.map((column) => (
                  <div>
                    <Text
                      tag="p"
                      variant="textBase"
                      class="font-medium text-foreground"
                    >
                      {column.category}
                    </Text>
                    <ul role="list" class="mt-2 ">
                      {column.links.map((link) => (
                        <li>
                          <Text
                            tag="a"
                            variant="textSM"
                            href={link.href}
                            class="text-muted-foreground hover:text-foreground duration-300"
                          >
                            {link.text}
                          </Text>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
