---
// Assets
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-12 lg:py-24">
      <Text tag="h2" variant="displaySM" class="font-medium text-foreground">
Links
      </Text>
      <div
        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12 text-muted-foreground mt-12"
      >
        <!-- Primary -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="font-medium uppercase text-foreground"
            >
              Primary text
            </Text>
            <div class="flex flex-col mt-2 gap-4">
              <Button isLink={true} href="#_" size="xxs" variant="primary"
                >Primary XXS</Button
              >
              <Button isLink={true} href="#_" size="xs" variant="primary"
                >Primary XS</Button
              >
              <Button isLink={true} href="#_" size="sm" variant="primary"
                >Primary SM</Button
              >
              <Button isLink={true} href="#_" size="base" variant="primary"
                >Primary Base</Button
              >
              <Button isLink={true} href="#_" size="md" variant="primary"
                >Primary MD</Button
              >
              <Button isLink={true} href="#_" size="lg" variant="primary"
                >Primary LG</Button
              >
              <Button isLink={true} href="#_" size="xl" variant="primary"
                >Primary XL</Button
              >
            </div>
          </div>
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="font-medium uppercase text-foreground"
            >
              Icon
            </Text>
            <div class="flex flex-col mt-2 gap-4">
              <Button
                isLink={true}
                href="#_"
                size="xxs"
                variant="primary"
                iconOnly><Plus slot="icon" size="sm" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="xs"
                variant="primary"
                iconOnly><Plus slot="icon" size="sm" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="sm"
                variant="primary"
                iconOnly><Plus slot="icon" size="base" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="base"
                variant="primary"
                iconOnly><Plus slot="icon" size="base" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="md"
                variant="primary"
                iconOnly><Plus slot="icon" size="lg" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="lg"
                variant="primary"
                iconOnly><Plus slot="icon" size="xl" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="xl"
                variant="primary"
                iconOnly><Plus slot="icon" size="xl" /></Button
              >
            </div>
          </div>
        </div>
        <!-- Accent -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="font-medium uppercase text-foreground"
            >
              Accent text
            </Text>
            <div class="flex flex-col mt-2 gap-4">
              <Button isLink={true} href="#_" size="xxs" variant="accent"
                >Accent XXS</Button
              >
              <Button isLink={true} href="#_" size="xs" variant="accent"
                >Accent XS</Button
              >
              <Button isLink={true} href="#_" size="sm" variant="accent"
                >Accent SM</Button
              >
              <Button isLink={true} href="#_" size="base" variant="accent"
                >Accent Base</Button
              >
              <Button isLink={true} href="#_" size="md" variant="accent"
                >Accent MD</Button
              >
              <Button isLink={true} href="#_" size="lg" variant="accent"
                >Accent LG</Button
              >
              <Button isLink={true} href="#_" size="xl" variant="accent"
                >Accent XL</Button
              >
            </div>
          </div>
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="font-medium uppercase text-foreground"
            >
              Icon
            </Text>
            <div class="flex flex-col mt-2 gap-4">
              <Button
                isLink={true}
                href="#_"
                size="xxs"
                variant="accent"
                iconOnly><Plus slot="icon" size="sm" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="xs"
                variant="accent"
                iconOnly><Plus slot="icon" size="sm" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="sm"
                variant="accent"
                iconOnly><Plus slot="icon" size="base" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="base"
                variant="accent"
                iconOnly><Plus slot="icon" size="base" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="md"
                variant="accent"
                iconOnly><Plus slot="icon" size="lg" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="lg"
                variant="accent"
                iconOnly><Plus slot="icon" size="xl" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="xl"
                variant="accent"
                iconOnly><Plus slot="icon" size="xl" /></Button
              >
            </div>
          </div>
        </div>
        <!-- Muted -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="font-medium uppercase text-foreground"
            >
              Muted text
            </Text>
            <div class="flex flex-col mt-2 gap-4">
              <Button isLink={true} href="#_" size="xxs" variant="muted"
                >Muted XXS</Button
              >
              <Button isLink={true} href="#_" size="xs" variant="muted"
                >Muted XS</Button
              >
              <Button isLink={true} href="#_" size="sm" variant="muted"
                >Muted SM</Button
              >
              <Button isLink={true} href="#_" size="base" variant="muted"
                >Muted Base</Button
              >
              <Button isLink={true} href="#_" size="md" variant="muted"
                >Muted MD</Button
              >
              <Button isLink={true} href="#_" size="lg" variant="muted"
                >Muted LG</Button
              >
              <Button isLink={true} href="#_" size="xl" variant="muted"
                >Muted XL</Button
              >
            </div>
          </div>
          <div>
            <Text
              tag="p"
              variant="textXS"
              class="font-medium uppercase text-foreground"
            >
              Icon
            </Text>
            <div class="flex flex-col mt-2 gap-4">
              <Button
                isLink={true}
                href="#_"
                size="xxs"
                variant="muted"
                iconOnly><Plus slot="icon" size="sm" /></Button
              >
              <Button isLink={true} href="#_" size="xs" variant="muted" iconOnly
                ><Plus slot="icon" size="sm" /></Button
              >
              <Button isLink={true} href="#_" size="sm" variant="muted" iconOnly
                ><Plus slot="icon" size="base" /></Button
              >
              <Button
                isLink={true}
                href="#_"
                size="base"
                variant="muted"
                iconOnly><Plus slot="icon" size="base" /></Button
              >
              <Button isLink={true} href="#_" size="md" variant="muted" iconOnly
                ><Plus slot="icon" size="lg" /></Button
              >
              <Button isLink={true} href="#_" size="lg" variant="muted" iconOnly
                ><Plus slot="icon" size="xl" /></Button
              >
              <Button isLink={true} href="#_" size="xl" variant="muted" iconOnly
                ><Plus slot="icon" size="xl" /></Button
              >
            </div>
          </div>
        </div>
      </div>
    </Wrapper>
  </section>
</BaseLayout>
