---
// Fundations
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
const colors = [
  { name: "Background", token: "--color-background", class: "bg-background ring-1 ring-border" },
  { name: "Foreground", token: "--color-foreground", class: "bg-foreground" },
  { name: "Muted", token: "--color-muted", class: "bg-muted" },
  { name: "Muted foreground", token: "--color-muted-foreground", class: "bg-muted-foreground" },
  { name: "Primary", token: "--color-primary", class: "bg-primary" },
  { name: "Primary foreground", token: "--color-primary-foreground", class: "bg-primary-foreground ring-1 ring-border" },
  { name: "Accent", token: "--color-accent", class: "bg-accent" },
  { name: "Accent foreground", token: "--color-accent-foreground", class: "bg-accent-foreground ring-1 ring-border" },
  { name: "Border", token: "--color-border", class: "bg-border" },
  { name: "Ring", token: "--color-ring", class: "bg-ring" },
];
---

<BaseLayout>
  <section>
    <Wrapper variant="standard" class="py-24">
      <Text tag="h1" variant="displaySM" class="font-medium text-foreground">
        Colors
      </Text>
      <div class="grid grid-cols-2 mt-12 gap-2 gap-y-8 lg:grid-cols-5">
        {
          colors.map((color) => (
            <div class="flex flex-col gap-2">
              <div class={`aspect-square rounded-md ${color.class}`} />
              <Text tag="span" variant="textSM" class="text-foreground">
                {color.name}
              </Text>
              <Text tag="span" variant="textXS" class="text-muted-foreground">
                {color.token}
              </Text>
            </div>
          ))
        }
      </div>
    </Wrapper>
  </section>
</BaseLayout>
