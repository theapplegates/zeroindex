---
import Text from "@/components/fundations/elements/Text.astro";
import PostCover from "@/components/blog/PostCover.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import { postHref, readingTime, type Post } from "@/lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const href = postHref(post.id);
const minutes = readingTime(post.body);
const coverAlt = post.data.coverAlt ?? post.data.title;
---

<li class="grid gap-5 border-t border-muted py-8 lg:grid-cols-12 lg:gap-8">
  {
    post.data.cover && (
      <div class="lg:col-span-4">
        <a href={href} aria-label={post.data.title} class="block">
          <PostCover publicId={post.data.cover} alt={coverAlt} widths={[320, 480, 640, 800]} />
        </a>
      </div>
    )
  }
  <div class:list={["flex min-w-0 flex-col items-start", post.data.cover ? "lg:col-span-8" : "lg:col-span-12"]}>
    <PostMeta date={post.data.date} readingTime={minutes} tags={post.data.tags} />
    <Text tag="h2" variant="displayXS" class="mt-3 font-semibold tracking-tight text-pretty">
      <a href={href} class="transition-colors duration-200 hover:text-muted-foreground">{post.data.title}</a>
    </Text>
    <Text tag="p" variant="textBase" class="mt-3 max-w-2xl text-pretty text-muted-foreground">{post.data.description}</Text>
    <a
      href={href}
      class="mt-5 flex items-center gap-1 text-sm font-medium text-foreground transition-colors duration-200 hover:text-muted-foreground"
    >
      Read the post
      <ChevronRight size="sm" />
    </a>
  </div>
</li>
