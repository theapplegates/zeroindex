---
import Text from "@/components/fundations/elements/Text.astro";
import CopyPage from "@/components/doc/CopyPage.astro";
import PostCover from "@/components/blog/PostCover.astro";
import PostMeta from "@/components/blog/PostMeta.astro";
import { site } from "@/lib/site";
import { type Post } from "@/lib/posts";

interface Props {
  post: Post;
  markdown: string;
  markdownHref: string;
  minutes: number;
}

const { post, markdown, markdownHref, minutes } = Astro.props;
const coverAlt = post.data.coverAlt ?? post.data.title;
const initials = post.data.author
  .split(/\s+/)
  .map((part) => part.charAt(0))
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<header class="flex flex-col gap-6 pb-10">
  {
    post.data.cover && (
      <PostCover publicId={post.data.cover} alt={coverAlt} widths={[640, 960, 1280]} loading="eager" />
    )
  }
  <div class="flex flex-col gap-4">
    <PostMeta date={post.data.date} readingTime={minutes} tags={post.data.tags} />
    <div class="flex flex-col-reverse items-start gap-4 sm:flex-row sm:justify-between lg:items-start">
      <div class="min-w-0">
        <Text tag="h1" variant="displayMD" class="font-semibold tracking-tight text-pretty text-foreground lg:text-balance">
          {post.data.title}
        </Text>
        <Text tag="p" variant="textLG" class="mt-3 text-pretty text-muted-foreground">
          {post.data.description}
        </Text>
      </div>
      <CopyPage markdown={markdown} markdownHref={markdownHref} />
    </div>
  </div>
  <div class="flex items-center gap-3 border-t border-muted pt-5">
    <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-foreground">
      {initials}
    </span>
    <div class="flex flex-col">
      <p class="text-sm font-medium text-foreground">{post.data.author || site.author}</p>
      <p class="text-xs text-muted-foreground">Field notes</p>
    </div>
  </div>
</header>
