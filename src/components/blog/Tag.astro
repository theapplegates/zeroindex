---
import { tagHref, tagLabel } from "@/lib/posts";

interface Props {
  tag: string;
  class?: string;
}

const { tag, class: className } = Astro.props;
---

<a
  href={tagHref(tag)}
  class:list={[
    "not-prose inline-flex h-6 items-center rounded-md border border-muted px-2 text-xs font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground",
    className,
  ]}
>
  {tagLabel(tag)}
</a>
