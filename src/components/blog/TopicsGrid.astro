---
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
import { tagHref } from "@/lib/posts";

interface Props {
  tags: { tag: string; label: string; count: number }[];
}

const { tags } = Astro.props;
---

<section>
  <Wrapper variant="panel" class="pb-24">
    <ul role="list" class="grid gap-3 sm:grid-cols-2">
      {
        tags.map(({ tag, label, count }) => (
          <li>
            <a
              href={tagHref(tag)}
              class="flex items-center justify-between gap-4 rounded-xl border border-muted bg-surface p-5 transition-all duration-200 hover:border-muted-foreground/20 hover:shadow-xs"
            >
              <span class="text-sm font-medium text-foreground">{label}</span>
              <span class="flex items-center gap-1 text-sm text-muted-foreground">
                {`${count} ${count === 1 ? "post" : "posts"}`}
                <ChevronRight size="sm" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>
