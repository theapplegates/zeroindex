---
// Icons
import Sparkles from "@/components/fundations/icons/Sparkles.astro";
import Expand from "@/components/fundations/icons/Expand.astro";
import Shrink from "@/components/fundations/icons/Shrink.astro";
import Close from "@/components/fundations/icons/Close.astro";
import ArrowUp from "@/components/fundations/icons/ArrowUp.astro";
import Code from "@/components/fundations/icons/Code.astro";

const iconButton = "hidden size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors duration-200 hover:text-foreground sm:flex";
---

<aside
  class="invisible fixed inset-2 z-40 flex translate-x-4 flex-col overflow-hidden rounded-2xl border border-muted bg-surface text-foreground opacity-0 shadow-xl transition-all duration-300 ease-out data-open:visible data-open:translate-x-0 data-open:opacity-100 motion-reduce:transition-none sm:left-auto sm:w-96 sm:data-expanded:w-160"
  aria-label="Assistant"
  data-assistant
>
  <div class="flex h-14 shrink-0 items-center justify-between gap-3 border-b border-muted px-4">
    <div class="flex items-center gap-2">
      <Sparkles size="base" class="text-accent" />
      <p class="font-medium">Assistant</p>
    </div>
    <div class="flex items-center gap-1">
      <button type="button" class={iconButton} aria-label="Expand" data-assistant-expand>
        <Expand size="sm" data-expand-icon />
        <Shrink size="sm" class="hidden" data-shrink-icon />
      </button>
      <button type="button" class="flex size-8 items-center justify-center rounded-lg text-muted-foreground transition-colors duration-200 hover:text-foreground" aria-label="Close assistant" data-assistant-close>
        <Close size="sm" />
      </button>
    </div>
  </div>
  <div class="grow overflow-y-auto p-4" data-lenis-prevent>
    <p class="mx-auto max-w-60 text-center text-xs text-pretty text-muted-foreground">Responses are generated using AI and may contain mistakes.</p>
    <ul class="mt-6 flex flex-col gap-4" data-assistant-messages></ul>
  </div>
  <form class="m-3 flex flex-col gap-3 rounded-xl border border-muted bg-background/50 p-3 transition-colors duration-200 focus-within:border-muted-foreground/50" data-assistant-form>
    <div class="hidden flex-wrap gap-2" data-assistant-chips></div>
    <label for="assistant-input" class="sr-only">Ask a question</label>
    <textarea
      id="assistant-input"
      rows="2"
      placeholder="Ask a question"
      class="resize-none border-0 bg-transparent p-0 text-sm text-foreground placeholder:text-muted-foreground focus:ring-0"
      data-assistant-input></textarea>
    <div class="flex items-center justify-between gap-3">
      <kbd class="font-sans text-xs text-muted-foreground">⌘I</kbd>
      <button
        type="submit"
        class="flex size-8 items-center justify-center rounded-full bg-foreground text-surface transition-opacity duration-200 disabled:opacity-30"
        aria-label="Send"
        disabled
        data-assistant-send
      >
        <ArrowUp size="sm" />
      </button>
    </div>
  </form>
  <template data-assistant-chip>
    <span class="flex h-7 max-w-48 items-center gap-1.5 rounded-lg border border-muted bg-surface pr-1 pl-2 text-xs text-foreground">
      <Code size="xs" class="text-muted-foreground" />
      <span class="truncate" data-chip-label></span>
      <button type="button" class="flex size-5 items-center justify-center rounded text-muted-foreground hover:text-foreground" aria-label="Remove" data-chip-remove>
        <Close size="xs" />
      </button>
    </span>
  </template>
</aside>

<script>
  type Snippet = { label: string; code: string };

  const panel = document.querySelector<HTMLElement>("[data-assistant]");
  const form = panel?.querySelector<HTMLFormElement>("[data-assistant-form]");
  const input = panel?.querySelector<HTMLTextAreaElement>("[data-assistant-input]");
  const send = panel?.querySelector<HTMLButtonElement>("[data-assistant-send]");
  const chips = panel?.querySelector<HTMLElement>("[data-assistant-chips]");
  const chipTemplate = panel?.querySelector<HTMLTemplateElement>("[data-assistant-chip]");
  const messages = panel?.querySelector<HTMLUListElement>("[data-assistant-messages]");
  const expand = panel?.querySelector<HTMLButtonElement>("[data-assistant-expand]");
  let snippets: Snippet[] = [];

  const open = () => {
    if (!panel) return;
    document.querySelectorAll<HTMLDetailsElement>("[data-copy-page-menu]").forEach((menu) => (menu.open = false));
    panel.setAttribute("data-open", "");
    input?.focus({ preventScroll: true });
  };
  const close = () => panel?.removeAttribute("data-open");
  const isOpen = () => panel?.hasAttribute("data-open") ?? false;

  const renderChips = () => {
    if (!chips || !chipTemplate) return;
    chips.replaceChildren(
      ...snippets.map((snippet, index) => {
        const chip = chipTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
        chip.querySelector("[data-chip-label]")!.textContent = snippet.label;
        chip.querySelector("[data-chip-remove]")!.addEventListener("click", () => {
          snippets = snippets.filter((_, i) => i !== index);
          renderChips();
        });
        return chip;
      }),
    );
    chips.classList.toggle("hidden", snippets.length === 0);
    chips.classList.toggle("flex", snippets.length > 0);
  };

  const addMessage = (text: string, from: "user" | "assistant") => {
    const item = document.createElement("li");
    item.className = from === "user" ? "ml-auto w-fit max-w-xs rounded-2xl bg-muted px-3 py-2 text-sm" : "max-w-full text-sm/6";
    item.textContent = text;
    messages?.append(item);
    item.scrollIntoView({ block: "end" });
  };

  input?.addEventListener("input", () => send && (send.disabled = !input.value.trim()));
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      form?.requestSubmit();
    }
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const question = input?.value.trim();
    if (!question || !input || !send) return;
    addMessage(question, "user");
    window.dispatchEvent(new CustomEvent("assistant:ask", { detail: { question, snippets, page: location.pathname } }));
    input.value = "";
    send.disabled = true;
    snippets = [];
    renderChips();
  });

  window.addEventListener("assistant:answer", (event) => {
    const { text } = (event as CustomEvent<{ text: string }>).detail;
    addMessage(text, "assistant");
  });

  expand?.addEventListener("click", () => {
    const expanded = panel?.toggleAttribute("data-expanded");
    expand.setAttribute("aria-label", expanded ? "Shrink" : "Expand");
    expand.querySelector("[data-expand-icon]")?.classList.toggle("hidden", expanded);
    expand.querySelector("[data-shrink-icon]")?.classList.toggle("hidden", !expanded);
  });

  panel?.querySelector("[data-assistant-close]")?.addEventListener("click", close);
  document.querySelectorAll("[data-assistant-open]").forEach((button) => button.addEventListener("click", open));

  document.querySelectorAll<HTMLButtonElement>("[data-code-ask]").forEach((button) => {
    button.addEventListener("click", () => {
      const code = button.closest("[data-code-block]")?.querySelector("pre")?.innerText.trim() ?? "";
      const firstLine = code.split("\n").find((line) => line.trim()) ?? "Code";
      snippets = [...snippets, { label: firstLine.trim(), code }];
      renderChips();
      open();
    });
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "i") {
      event.preventDefault();
      if (isOpen()) close();
      else open();
    }
    if (event.key === "Escape" && isOpen() && panel?.contains(document.activeElement)) close();
  });
</script>
