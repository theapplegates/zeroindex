---
// Content
import { getDocGroups, docHref } from "@/lib/docs";
import { getEndpointGroups, apiHref } from "@/lib/api";
import { getSdks, sdkHref } from "@/lib/sdks";

interface Item {
  title: string;
  href: string;
}

const current = Astro.url.pathname.replace(/\/$/, "");
const section = current.startsWith("/api") ? "api" : current.startsWith("/sdks") ? "sdks" : "docs";
const labels = { api: "API reference", sdks: "SDKs", docs: "Docs" };

const loaders = {
  api: async () =>
    (await getEndpointGroups()).map((group) => ({
      label: group.label,
      items: group.endpoints.map((entry) => ({ title: entry.data.title, href: apiHref(entry.id) })),
    })),
  sdks: async () => [
    {
      label: "SDKs",
      items: [{ title: "All SDKs", href: "/sdks" }, ...(await getSdks()).map((sdk) => ({ title: sdk.data.title, href: sdkHref(sdk.id) }))],
    },
  ],
  docs: async () =>
    (await getDocGroups()).map((group) => ({
      label: group.label,
      items: group.docs.map((doc) => ({ title: doc.data.title, href: docHref(doc.id) })),
    })),
};
const groups: { label: string; items: Item[] }[] = await loaders[section]();
---

<nav class="flex flex-col gap-6" aria-label={labels[section]}>
  {
    groups.map((group) => (
      <div class="flex flex-col gap-1">
        <p class="px-3 pb-1 text-sm font-medium text-foreground">{group.label}</p>
        <ul class="flex flex-col gap-0.5">
          {group.items.map((item) => {
            const active = current === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "block rounded-lg px-3 py-1.5 text-sm transition-colors duration-200",
                    active ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground",
                  ]}
                >
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</nav>
