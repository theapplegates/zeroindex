---
// Fundations
import Logo from "@/components/assets/Logo.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Components
import SearchButton from "@/components/global/SearchButton.astro";
import SearchDialog from "@/components/global/SearchDialog.astro";
import ThemeMenu from "@/components/global/ThemeMenu.astro";
import MobileMenu from "@/components/global/MobileMenu.astro";
import AssistantPanel from "@/components/global/AssistantPanel.astro";
// Config
import { config } from "@/config";
// Icons
import Search from "@/components/fundations/icons/Search.astro";
import Menu from "@/components/fundations/icons/Menu.astro";
import Sparkles from "@/components/fundations/icons/Sparkles.astro";

interface Props {
  // Docs pages carry search and the theme toggle in their sidebar.
  sidebar?: boolean;
}

const { sidebar = false } = Astro.props;
const links = [
  { label: "Guides", href: "/docs/getting-started/introduction" },
  { label: "API reference", href: "/api/introduction" },
  { label: "SDKs", href: "/sdks" },
  { label: "Changelog", href: "/changelog" },
  { label: "Overview", href: "/system/overview" },
];
const linkClass = "text-sm font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground";
---

<header class="sticky top-0 z-30 bg-background">
  <div class:list={["flex h-14 items-center justify-between gap-4", sidebar ? "px-4 lg:px-6" : "mx-auto w-full max-w-340 px-4 lg:px-24 2xl:max-w-380"]}>
    <div class="flex items-center gap-8">
      <a href="/" aria-label="ZeroIndex home"><Logo /></a>
      {
        !sidebar && (
          <div class="hidden w-64 xl:block">
            <SearchButton />
          </div>
        )
      }
    </div>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {links.map((link) => <a href={link.href} class={linkClass}>{link.label}</a>)}
      {
        !sidebar && (
          <button type="button" class="flex size-8 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground xl:hidden" aria-label="Search" data-search-open>
            <Search size="sm" />
          </button>
        )
      }
      {!sidebar && <ThemeMenu />}
      <Button isLink={true} href="https://lexingtonthemes.com/templates/zeroindex" size="sm" variant="primary">
        Buy ZeroIndex
      </Button>
    </nav>
    <div class="flex items-center gap-1 lg:hidden">
      {
        config.assistant && (
          <button type="button" class="flex size-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground" aria-label="Ask the assistant" data-assistant-open>
            <Sparkles size="base" />
          </button>
        )
      }
      <button type="button" class="flex size-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground" aria-label="Search" data-search-open>
        <Search size="base" />
      </button>
      <button type="button" class="flex size-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground" aria-label="Open menu" data-menu-open>
        <Menu size="base" />
      </button>
    </div>
  </div>
</header>
<SearchDialog />
<MobileMenu />
{config.assistant && <AssistantPanel />}
