---
// Components
import SearchButton from "@/components/global/SearchButton.astro";
import SidebarNav from "@/components/global/SidebarNav.astro";
import ThemeToggle from "@/components/global/ThemeToggle.astro";
// Icons
import Sparkles from "@/components/fundations/icons/Sparkles.astro";
// Config
import { config } from "@/config";
---

<aside class="hidden w-64 shrink-0 flex-col lg:flex">
  <div class="flex flex-col gap-2 px-3 pt-2 pb-6">
    <SearchButton />
    {
      config.assistant && (
        <button
          type="button"
          class="flex h-9 w-full items-center gap-2 rounded-lg border border-muted bg-surface px-3 text-sm text-muted-foreground transition-colors duration-200 hover:text-foreground"
          data-assistant-open
        >
          <Sparkles size="sm" class="text-accent" />
          <span class="grow text-left">Ask AI</span>
          <kbd class="font-sans text-xs">⌘I</kbd>
        </button>
      )
    }
  </div>
  <div class="grow overflow-y-auto px-3 pb-6" data-sidebar-scroll>
    <SidebarNav />
  </div>
  <div class="border-t border-muted p-4">
    <ThemeToggle />
  </div>
</aside>
