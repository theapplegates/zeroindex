---
// Components
import SearchButton from "@/components/global/SearchButton.astro";
import SidebarNav from "@/components/global/SidebarNav.astro";
import ThemeToggle from "@/components/global/ThemeToggle.astro";
---

<aside class="hidden w-64 shrink-0 flex-col lg:flex">
  <div class="px-3 pt-2 pb-6">
    <SearchButton />
  </div>
  <div class="grow overflow-y-auto px-3 pb-6" data-sidebar-scroll>
    <SidebarNav />
  </div>
  <div class="border-t border-muted p-4">
    <ThemeToggle />
  </div>
</aside>
