---
// Components
import SearchButton from "@/components/global/SearchButton.astro";
import SidebarNav from "@/components/global/SidebarNav.astro";
import ThemeToggle from "@/components/global/ThemeToggle.astro";
// Icons
import Sparkles from "@/components/fundations/icons/Sparkles.astro";
// Config
import { config } from "@/config";
---

<aside class="hidden w-64 shrink-0 flex-col lg:flex">
  <div class="flex gap-2 px-3 pt-2 pb-6">
    <SearchButton />
    {
      config.assistant && (
        <button
          type="button"
          class="flex size-9 shrink-0 items-center justify-center rounded-lg border border-muted bg-surface text-muted-foreground transition-colors duration-200 hover:text-foreground"
          aria-label="Ask AI (⌘I)"
          title="Ask AI (⌘I)"
          data-assistant-open
        >
          <Sparkles size="sm" />
        </button>
      )
    }
  </div>
  <div class="grow overflow-y-auto px-3 pb-6" data-sidebar-scroll>
    <SidebarNav />
  </div>
  <div class="border-t border-muted p-4">
    <ThemeToggle />
  </div>
</aside>
