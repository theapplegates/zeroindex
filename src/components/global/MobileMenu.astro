---
// Fundations
import Logo from "@/components/assets/Logo.astro";
import Button from "@/components/fundations/elements/Button.astro";
// Components
import SidebarNav from "@/components/global/SidebarNav.astro";
import ThemeToggle from "@/components/global/ThemeToggle.astro";
// Icons
import Close from "@/components/fundations/icons/Close.astro";

const links = [
  { label: "Guides", href: "/docs/getting-started/introduction" },
  { label: "API reference", href: "/api/introduction" },
  { label: "SDKs", href: "/sdks" },
  { label: "Changelog", href: "/changelog" },
  { label: "Overview", href: "/system/overview" },
];
---

<dialog
  class="m-0 h-svh max-h-none w-80 max-w-full flex-col bg-background p-0 text-foreground backdrop:bg-foreground/20 open:flex"
  aria-label="Menu"
  data-menu-dialog
>
  <div class="flex h-14 shrink-0 items-center justify-between px-4">
    <Logo />
    <button type="button" class="flex size-9 items-center justify-center rounded-lg text-muted-foreground hover:text-foreground" aria-label="Close menu" data-menu-close>
      <Close size="base" />
    </button>
  </div>
  <div class="grow overflow-y-auto px-3 py-4">
    <SidebarNav />
  </div>
  <div class="flex flex-col gap-4 border-t border-muted p-4">
    {links.map((link) => <a href={link.href} class="text-sm font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground">{link.label}</a>)}
    <Button isLink={true} href="https://lexingtonthemes.com/templates/zeroindex" size="base" variant="primary">Buy ZeroIndex</Button>
    <ThemeToggle />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-menu-dialog]");
  document.querySelector("[data-menu-open]")?.addEventListener("click", () => dialog?.showModal());
  document.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
