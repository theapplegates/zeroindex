---
import Seo from "@/components/fundations/head/Seo.astro";
import Meta from "@/components/fundations/head/Meta.astro";
import Fonts from "@/components/fundations/head/Fonts.astro";
import Favicons from "@/components/fundations/head/Favicons.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  updatedTime?: Date;
  noindex?: boolean;
}

const { title, description, image, type, publishedTime, updatedTime, noindex } = Astro.props;
---

<Seo
  title={title}
  description={description}
  image={image}
  type={type}
  publishedTime={publishedTime}
  updatedTime={updatedTime}
  noindex={noindex}
/>
<Meta />
<Fonts />
<Favicons />
<link rel="alternate" type="application/rss+xml" title="Field notes" href="/rss.xml" />
