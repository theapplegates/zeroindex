---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import SystemRow from "@/components/system/SystemRow.astro";

const pageSections = [
  {
    title: "Static",
    note: "The home page, status, the 404 and the system pages.",
    columns: [
      {
        category: "Pages",
        links: [
          { text: "Home", href: "/" },
          { text: "Status", href: "/status" },
          { text: "404", href: "/404" },
        ],
      },
      {
        category: "System",
        links: [
          { text: "Colors", href: "/system/colors" },
          { text: "Links", href: "/system/link" },
          { text: "Buttons", href: "/system/buttons" },
          { text: "Typography", href: "/system/typography" },
          { text: "Docs components", href: "/docs/writing/components" },
        ],
      },
      {
        category: "Resources",
        links: [
          { text: "License", href: "https://lexingtonthemes.com/legal/license" },
          { text: "Documentation", href: "https://lexingtonthemes.com/documentation" },
        ],
      },
    ],
  },
  {
    title: "Content collections",
    note: "An index and one detail page for each collection. Docs and API pages also come as Markdown.",
    columns: [
      {
        category: "Docs",
        links: [
          { text: "Index", href: "/docs" },
          { text: "Page", href: "/docs/getting-started/quickstart" },
          { text: "Page as Markdown", href: "/docs/getting-started/quickstart.md" },
        ],
      },
      {
        category: "API reference",
        links: [
          { text: "Index", href: "/api" },
          { text: "Endpoint", href: "/api/search" },
          { text: "Endpoint as Markdown", href: "/api/search.md" },
        ],
      },
      {
        category: "SDKs",
        links: [
          { text: "Index", href: "/sdks" },
          { text: "SDK", href: "/sdks/javascript" },
        ],
      },
      {
        category: "Changelog",
        links: [
          { text: "Index", href: "/changelog" },
          { text: "Release", href: "/changelog/swap-indexes" },
        ],
      },
    ],
  },
];
---

<section>
  <Wrapper variant="standard" class="pb-24">
    {
      pageSections.map((section) => (
        <SystemRow name={section.title} text={section.note}>
          <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2">
            {section.columns.map((column) => (
              <div class="flex flex-col gap-3">
                <Text tag="h3" variant="textSM" class="text-muted-foreground">
                  {column.category}
                </Text>
                <ul role="list" class="flex flex-col gap-1">
                  {column.links.map((link) => (
                    <li>
                      <Text tag="a" href={link.href} variant="textLG" class="font-medium text-foreground transition-colors duration-200 hover:text-muted-foreground">
                        {link.text}
                      </Text>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </SystemRow>
      ))
    }
  </Wrapper>
</section>
