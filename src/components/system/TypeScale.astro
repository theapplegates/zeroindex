---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const display = ["display4XL", "display3XL", "display2XL", "displayXL", "displayLG", "displayMD", "displaySM", "displayXS"];
const text = ["textXL", "textLG", "textBase", "textSM", "textXS"];
---

<section>
  <Wrapper variant="standard" class="pb-24">
    <div class="flex flex-col gap-4">
      <div class="rounded-2xl border border-muted bg-surface">
        <div class="border-b border-muted px-6 py-4">
          <Text tag="h2" variant="textBase" class="font-medium">Display, Geist semibold</Text>
        </div>
        <ul role="list" class="divide-y divide-muted">
          {
            display.map((variant) => (
              <li class="grid gap-2 px-6 py-6 lg:grid-cols-12 lg:gap-8">
                <Text tag="span" variant="textSM" class="text-muted-foreground lg:col-span-2">{variant}</Text>
                <Text tag="p" variant={variant} class="truncate font-semibold tracking-tight lg:col-span-10">Search that forgives typos</Text>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl border border-muted bg-surface">
        <div class="border-b border-muted px-6 py-4">
          <Text tag="h2" variant="textBase" class="font-medium">Text, Geist regular</Text>
        </div>
        <ul role="list" class="divide-y divide-muted">
          {
            text.map((variant) => (
              <li class="grid gap-2 px-6 py-6 lg:grid-cols-12 lg:gap-8">
                <Text tag="span" variant="textSM" class="text-muted-foreground lg:col-span-2">{variant}</Text>
                <Text tag="p" variant={variant} class="max-w-3xl text-pretty lg:col-span-10">
                  Send ZeroIndex your content as JSON and get ranked, typo tolerant results back in a single request, usually in under 50 ms.
                </Text>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-2xl border border-muted bg-surface">
        <div class="border-b border-muted px-6 py-4">
          <Text tag="h2" variant="textBase" class="font-medium">Code, Geist Mono</Text>
        </div>
        <div class="grid gap-2 px-6 py-6 lg:grid-cols-12 lg:gap-8">
          <Text tag="span" variant="textSM" class="text-muted-foreground lg:col-span-2">font-mono</Text>
          <code class="font-mono text-sm lg:col-span-10">await client.index("products").search("wirless");</code>
        </div>
      </div>
    </div>
  </Wrapper>
</section>
