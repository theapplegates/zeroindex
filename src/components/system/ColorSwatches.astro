---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";

const colors = [
  { name: "Background", token: "--color-background", class: "bg-background", use: "The page ground" },
  { name: "Surface", token: "--color-surface", class: "bg-surface", use: "Content panel and cards" },
  { name: "Foreground", token: "--color-foreground", class: "bg-foreground", use: "Text and primary buttons" },
  { name: "Muted", token: "--color-muted", class: "bg-muted", use: "Lines, inline code and hovers" },
  { name: "Muted foreground", token: "--color-muted-foreground", class: "bg-muted-foreground", use: "Secondary text" },
  { name: "Accent", token: "--color-accent", class: "bg-accent", use: "Active items and icons" },
  { name: "Success", token: "--color-success", class: "bg-success", use: "Operational and GET" },
  { name: "Danger", token: "--color-danger", class: "bg-danger", use: "Errors and DELETE" },
];
---

<section>
  <Wrapper variant="standard" class="pb-24">
    <ul role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        colors.map((color) => (
          <li class="flex flex-col gap-4 rounded-2xl border border-muted bg-surface p-2">
            <div class:list={["aspect-video rounded-lg border border-muted", color.class]} />
            <div class="flex flex-col gap-1 px-2 pb-2">
              <Text tag="h2" variant="textSM" class="font-medium">{color.name}</Text>
              <code class="font-mono text-xs text-muted-foreground">{color.token}</code>
              <Text tag="p" variant="textSM" class="text-muted-foreground">{color.use}</Text>
            </div>
          </li>
        ))
      }
    </ul>
  </Wrapper>
</section>
