---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
// Icons
import Copy from "@/components/fundations/icons/Copy.astro";
import Check from "@/components/fundations/icons/Check.astro";
import Sparkles from "@/components/fundations/icons/Sparkles.astro";
// Config
import { config } from "@/config";

interface Props {
  code: string;
  lang: ComponentProps<typeof Code>["lang"];
}

const { code, lang } = Astro.props;
const actionClass = "flex size-8 items-center justify-center rounded-lg bg-background text-muted-foreground transition-colors duration-200 hover:text-foreground";
---

<div class="group relative" data-code-block>
  <Code code={code.trim()} lang={lang} theme="css-variables" class="overflow-x-auto p-4 text-sm/7" />
  <div class="absolute top-2 right-2 flex gap-1 opacity-0 transition duration-200 group-hover:opacity-100 focus-within:opacity-100">
    {
      config.assistant && (
        <button type="button" class={actionClass} aria-label="Ask the assistant about this code" data-code-ask>
          <Sparkles size="sm" />
        </button>
      )
    }
    <button type="button" class={actionClass} aria-label="Copy code" data-code-copy>
      <Copy size="sm" data-copy-idle />
      <Check size="sm" class="hidden" data-copy-done />
    </button>
  </div>
</div>

<script>
  import "@/scripts/copy-code";
</script>
