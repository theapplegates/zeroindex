---
import { Code } from "astro:components";
import type { ComponentProps } from "astro/types";
// Icons
import Copy from "@/components/fundations/icons/Copy.astro";
import Check from "@/components/fundations/icons/Check.astro";

interface Props {
  code: string;
  lang: ComponentProps<typeof Code>["lang"];
}

const { code, lang } = Astro.props;
---

<div class="group relative" data-code-block>
  <Code code={code.trim()} lang={lang} theme="css-variables" class="overflow-x-auto p-4 text-sm/7" />
  <button
    type="button"
    class="absolute top-2 right-2 flex size-8 items-center justify-center rounded-lg bg-background text-muted-foreground opacity-0 transition duration-200 group-hover:opacity-100 hover:text-foreground focus-visible:opacity-100"
    aria-label="Copy code"
    data-code-copy
  >
    <Copy size="sm" data-copy-idle />
    <Check size="sm" class="hidden" data-copy-done />
  </button>
</div>

<script>
  import "@/scripts/copy-code";
</script>
