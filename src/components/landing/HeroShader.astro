---
// A slow, soft glow in the accent colour. Pure WebGL, no dependencies; still for reduced motion.
---

<canvas class="pointer-events-none absolute inset-0 size-full" aria-hidden="true" data-hero-shader></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-shader]");
  const gl = canvas?.getContext("webgl", { premultipliedAlpha: true, antialias: false });

  const vertex = `
    attribute vec2 position;
    void main() { gl_Position = vec4(position, 0.0, 1.0); }
  `;

  const fragment = `
    precision mediump float;
    uniform vec2 resolution;
    uniform float time;
    uniform vec3 color;
    uniform float strength;

    float blob(vec2 p, vec2 center, float radius) {
      float d = distance(p, center);
      return exp(-(d * d) / (radius * radius));
    }

    void main() {
      vec2 uv = gl_FragCoord.xy / resolution;
      float aspect = resolution.x / resolution.y;
      vec2 p = vec2(uv.x * aspect, uv.y);
      float t = time * 0.12;

      float glow = 0.0;
      glow += blob(p, vec2((0.82 + 0.06 * sin(t)) * aspect, 0.95 + 0.05 * cos(t * 0.8)), 0.45);
      glow += 0.7 * blob(p, vec2((0.62 + 0.08 * cos(t * 0.7)) * aspect, 1.05 + 0.06 * sin(t * 0.9)), 0.35);
      glow += 0.5 * blob(p, vec2((0.95 + 0.05 * sin(t * 1.3)) * aspect, 0.7 + 0.08 * cos(t * 0.6)), 0.3);

      float alpha = clamp(glow, 0.0, 1.0) * smoothstep(0.2, 0.9, uv.y) * strength;
      gl_FragColor = vec4(color * alpha, alpha);
    }
  `;

  const compile = (type: number, source: string) => {
    const shader = gl!.createShader(type)!;
    gl!.shaderSource(shader, source);
    gl!.compileShader(shader);
    return shader;
  };

  const toRgb = (value: string) => {
    const probe = document.createElement("canvas").getContext("2d")!;
    probe.fillStyle = value;
    probe.fillRect(0, 0, 1, 1);
    const [r, g, b] = probe.getImageData(0, 0, 1, 1).data;
    return [r / 255, g / 255, b / 255];
  };

  if (canvas && gl) {
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, vertex));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragment));
    gl.linkProgram(program);
    gl.useProgram(program);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const position = gl.getAttribLocation(program, "position");
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    const uniforms = {
      resolution: gl.getUniformLocation(program, "resolution"),
      time: gl.getUniformLocation(program, "time"),
      color: gl.getUniformLocation(program, "color"),
      strength: gl.getUniformLocation(program, "strength"),
    };

    const setColor = () => {
      const styles = getComputedStyle(document.documentElement);
      gl.uniform3fv(uniforms.color, toRgb(styles.getPropertyValue("--accent")));
      gl.uniform1f(uniforms.strength, document.documentElement.classList.contains("dark") ? 0.3 : 0.18);
    };

    const resize = () => {
      const ratio = Math.min(window.devicePixelRatio, 1.5);
      canvas.width = canvas.clientWidth * ratio;
      canvas.height = canvas.clientHeight * ratio;
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uniforms.resolution, canvas.width, canvas.height);
    };

    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = true;
    let frame = 0;
    const start = performance.now();

    const draw = () => {
      gl.uniform1f(uniforms.time, still ? 20 : (performance.now() - start) / 1000);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      if (!still && visible) frame = requestAnimationFrame(draw);
    };

    setColor();
    resize();
    draw();

    new ResizeObserver(() => {
      resize();
      if (still) draw();
    }).observe(canvas);

    new MutationObserver(() => {
      setColor();
      if (still) draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      cancelAnimationFrame(frame);
      if (visible && !still) draw();
    }).observe(canvas);
  }
</script>
