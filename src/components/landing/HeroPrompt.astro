---
// Icons
import ClaudeLogo from "@/components/fundations/icons/ClaudeLogo.astro";
import CursorLogo from "@/components/fundations/icons/CursorLogo.astro";
import CodexLogo from "@/components/fundations/icons/CodexLogo.astro";

const prompt = "Add ZeroIndex search to my app: zeroindex.test/SKILL.md";
const agents = [ClaudeLogo, CursorLogo, CodexLogo];
---

<div class="flex w-fit max-w-full items-center gap-3 rounded-lg border border-muted bg-surface p-1 pr-4">
  <div class="flex shrink-0 -space-x-1.5" aria-hidden="true">
    {
      agents.map((Icon) => (
        <span class="flex size-7 items-center justify-center rounded-sm border-2 border-surface bg-background text-foreground">
          <Icon size="xs" />
        </span>
      ))
    }
  </div>
  <code class="truncate font-mono text-sm text-foreground">{prompt}</code>
</div>
