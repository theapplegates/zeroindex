---
import { Code } from "astro:components";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import CodeGroup from "@/components/docs/CodeGroup.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";

const samples = [
  {
    label: "cURL",
    lang: "bash",
    code: `curl https://api.zeroindex.test/v1/indexes/products/search \\
  -H "Authorization: Bearer $ZEROINDEX_KEY" \\
  -d '{ "q": "wireless hedphones", "limit": 5 }'`,
  },
  {
    label: "JavaScript",
    lang: "js",
    code: `import { ZeroIndex } from "@zeroindex/client";

const client = new ZeroIndex(process.env.ZEROINDEX_KEY);
const { hits } = await client.index("products").search("wireless hedphones", { limit: 5 });`,
  },
  {
    label: "Python",
    lang: "python",
    code: `import os
from zeroindex import ZeroIndex

client = ZeroIndex(os.environ["ZEROINDEX_KEY"])
hits = client.index("products").search("wireless hedphones", limit=5).hits`,
  },
] as const;
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="flex flex-col items-start lg:col-span-5">
        <Text tag="h2" variant="displaySM" class="font-semibold tracking-tight text-pretty">One request, ranked results</Text>
        <Text tag="p" variant="textBase" class="mt-2 text-pretty text-muted-foreground">
          Send a query, typos and all, and get the best matches back with the matching words highlighted. The same call works from cURL and
          every SDK.
        </Text>
        <a
          href="/docs/getting-started/introduction"
          class="mt-6 flex items-center gap-1 text-sm font-medium text-foreground transition-colors duration-200 hover:text-muted-foreground"
        >
          How search works
          <ChevronRight size="sm" />
        </a>
      </div>
      <div class="min-w-0 lg:col-span-7">
        <CodeGroup labels={samples.map((sample) => sample.label)} class="">
          {
            samples.map((sample) => (
              <div>
                <Code code={sample.code} lang={sample.lang} theme="css-variables" class="overflow-x-auto p-4 text-sm/7" />
              </div>
            ))
          }
        </CodeGroup>
      </div>
    </div>
  </Wrapper>
</section>
