---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Badge from "@/components/docs/Badge.astro";
// Icons
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";
// Content
import { getReleases, releaseHref, formatDate } from "@/lib/changelog";

const releases = (await getReleases()).slice(0, 3);
---

<section>
  <Wrapper variant="panel" class="py-24">
    <div class="flex flex-col gap-6 sm:flex-row sm:justify-between lg:items-end">
      <div>
        <Text tag="h2" variant="displaySM" class="font-semibold tracking-tight">Latest releases</Text>
        <Text tag="p" variant="textBase" class="mt-2 text-pretty text-muted-foreground">What changed in the API and SDKs recently.</Text>
      </div>
      <a href="/changelog" class="flex shrink-0 items-center gap-1 text-sm font-medium text-foreground transition-colors duration-200 hover:text-muted-foreground">
        Full changelog
        <ChevronRight size="sm" />
      </a>
    </div>
    <ol role="list" class="mt-10 flex flex-col">
      {
        releases.map((release) => (
          <li class="border-t border-muted">
            <a href={releaseHref(release.id)} class="group grid gap-2 py-6 lg:grid-cols-12 lg:gap-8">
              <div class="flex items-center gap-3 lg:col-span-3">
                <time datetime={release.data.date.toISOString()} class="text-sm text-muted-foreground">
                  {formatDate(release.data.date)}
                </time>
                <Badge variant="outline">v{release.data.version}</Badge>
              </div>
              <div class="flex flex-col gap-1 lg:col-span-9">
                <Text tag="h3" variant="textBase" class="font-medium transition-colors duration-200 group-hover:text-muted-foreground">
                  {release.data.title}
                </Text>
                <Text tag="p" variant="textSM" class="max-w-2xl text-pretty text-muted-foreground">{release.data.summary}</Text>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </Wrapper>
</section>
