---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import Card from "@/components/docs/Card.astro";

const cards = [
  {
    title: "Introduction",
    icon: "book",
    href: "/docs/getting-started/introduction",
    text: "What ZeroIndex does, how indexes and documents fit together, and where to go next.",
  },
  {
    title: "Quickstart",
    icon: "rocket",
    href: "/docs/getting-started/quickstart",
    text: "Create an index, add a few documents and run your first search in about five minutes.",
  },
  {
    title: "Authentication",
    icon: "key",
    href: "/docs/getting-started/authentication",
    text: "Admin keys for your server, search keys for the browser, and how to rotate both.",
  },
  {
    title: "Writing docs",
    icon: "layers",
    href: "/docs/writing/components",
    text: "Callouts, code groups, steps, tabs and every other component these pages are built from.",
  },
] as const;
---

<section>
  <Wrapper variant="standard" class="py-24">
    <Text tag="h2" variant="displaySM" class="font-semibold tracking-tight">Start here</Text>
    <Text tag="p" variant="textBase" class="mt-2 text-pretty text-muted-foreground">New to ZeroIndex? These four pages cover the basics.</Text>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        cards.map((card) => (
          <Card title={card.title} icon={card.icon} href={card.href}>
            {card.text}
          </Card>
        ))
      }
    </div>
  </Wrapper>
</section>
