---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="max-w-2xl">
      <Text tag="h1" variant="displayLG" class="font-semibold tracking-tight text-pretty lg:text-balance">Changelog</Text>
      <Text tag="p" variant="textLG" class="mt-4 text-pretty text-muted-foreground">
        New features, improvements and fixes to the ZeroIndex API and SDKs. Nothing here breaks existing code unless it says so.
      </Text>
    </div>
  </Wrapper>
</section>
