---
// Components
import DocPagination from "@/components/doc/DocPagination.astro";
import PageFeedback from "@/components/doc/PageFeedback.astro";
// Config
import { config } from "@/config";

interface Link {
  title: string;
  href: string;
  description?: string;
}

interface Props {
  lastUpdated: Date;
  previous?: Link;
  next?: Link;
}

const { lastUpdated, previous, next } = Astro.props;
const date = lastUpdated.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const links = [
  { label: "License", href: "https://lexingtonthemes.com/legal/license" },
  { label: "Documentation", href: "https://lexingtonthemes.com/documentation" },
];
---

<footer class="flex flex-col gap-10 pt-16">
  <div class="flex flex-wrap items-center justify-between gap-4">
    <p class="text-sm text-muted-foreground">
      Last updated <time datetime={lastUpdated.toISOString()}>{date}</time>
    </p>
    {config.feedback && <PageFeedback />}
  </div>
  <DocPagination previous={previous} next={next} />
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-muted pt-6 text-sm text-muted-foreground">
    <p>© {new Date().getFullYear()} ZeroIndex</p>
    <div class="flex gap-4">
      {links.map((link) => <a href={link.href} class="transition-colors duration-200 hover:text-foreground">{link.label}</a>)}
    </div>
  </div>
</footer>
