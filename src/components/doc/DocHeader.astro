---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
// Components
import CopyPage from "@/components/doc/CopyPage.astro";

interface Props {
  title: string;
  description: string;
  markdown: string;
  markdownHref: string;
}

const { title, description, markdown, markdownHref } = Astro.props;
---

<header class="flex flex-col gap-3 pb-10">
  <div class="flex flex-col-reverse items-start gap-4 sm:flex-row sm:justify-between lg:items-end">
    <Text tag="h1" variant="displaySM" class="font-semibold tracking-tight text-pretty text-foreground">
      {title}
    </Text>
    <CopyPage markdown={markdown} markdownHref={markdownHref} />
  </div>
  <Text tag="p" variant="textLG" class="text-pretty text-muted-foreground">
    {description}
  </Text>
  <slot />
</header>
