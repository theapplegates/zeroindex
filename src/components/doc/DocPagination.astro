---
// Icons
import ChevronLeft from "@/components/fundations/icons/ChevronLeft.astro";
import ChevronRight from "@/components/fundations/icons/ChevronRight.astro";

interface Link {
  title: string;
  href: string;
  description?: string;
}

interface Props {
  previous?: Link;
  next?: Link;
}

const { previous, next } = Astro.props;
const card = next ?? previous;
const isNext = Boolean(next);
const cardClass =
  "flex min-w-0 flex-1 items-center gap-4 rounded-xl border border-muted bg-surface p-4 shadow-xs transition-colors duration-200 hover:border-muted-foreground/20 hover:bg-background";
const labelClass = "flex shrink-0 items-center gap-1 text-sm font-medium text-foreground";
---

{
  card && (
    <nav class="flex rounded-2xl bg-background/50 p-1" aria-label="Previous and next">
      {previous && next && (
        <a
          href={previous.href}
          class="flex shrink-0 items-center gap-1 px-4 text-sm font-medium text-muted-foreground transition-colors duration-200 hover:text-foreground"
          aria-label={`Previous: ${previous.title}`}
        >
          <ChevronLeft size="xs" />
          Previous
        </a>
      )}
      <a href={card.href} class={cardClass}>
        {!isNext && (
          <span class:list={[labelClass, "self-stretch border-r border-muted pr-4"]}>
            <ChevronLeft size="xs" />
            Previous
          </span>
        )}
        <span class:list={["flex min-w-0 flex-1 flex-col gap-0.5", isNext && "items-end"]}>
          <span class="max-w-full truncate text-sm font-medium text-foreground">{card.title}</span>
          {card.description && <span class="max-w-full truncate text-sm text-muted-foreground">{card.description}</span>}
        </span>
        {isNext && (
          <span class:list={[labelClass, "self-stretch border-l border-muted pl-4"]}>
            Next
            <ChevronRight size="xs" />
          </span>
        )}
      </a>
    </nav>
  )
}
