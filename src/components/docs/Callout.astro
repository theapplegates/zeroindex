---
// Icons
import Info from "@/components/fundations/icons/Info.astro";
import Idea from "@/components/fundations/icons/Idea.astro";
import Warning from "@/components/fundations/icons/Warning.astro";
import Danger from "@/components/fundations/icons/Danger.astro";

interface Props {
  type?: "note" | "tip" | "warning" | "danger";
  title?: string;
}

const { type = "note", title } = Astro.props;
const styles = {
  note: { icon: Info, box: "border-muted bg-background", iconClass: "text-muted-foreground" },
  tip: { icon: Idea, box: "border-muted bg-background", iconClass: "text-muted-foreground" },
  warning: { icon: Warning, box: "border-accent/40 bg-accent/10", iconClass: "text-accent" },
  danger: { icon: Danger, box: "border-danger/30 bg-danger/5", iconClass: "text-danger" },
};
const { icon: Icon, box, iconClass } = styles[type];
---

<aside class:list={["my-6 flex gap-3 rounded-xl border p-4 text-sm/6 prose-p:my-0", box]}>
  <Icon size="base" class:list={["mt-0.5", iconClass]} />
  <div class="flex min-w-0 flex-col gap-1">
    {title && <p class="font-medium text-foreground">{title}</p>}
    <div class="text-muted-foreground"><slot /></div>
  </div>
</aside>
