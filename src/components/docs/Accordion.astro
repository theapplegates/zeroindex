---
// Icons
import ChevronDown from "@/components/fundations/icons/ChevronDown.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<details class="group border-b border-muted prose-p:my-0 first-of-type:border-t">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-sm font-medium text-foreground">
    {title}
    <ChevronDown size="sm" class="text-muted-foreground transition-transform duration-200 group-open:rotate-180" />
  </summary>
  <div class="pb-4 text-sm/6 text-muted-foreground">
    <slot />
  </div>
</details>
