---
interface Props {
  name: string;
  type: string;
}

const { name, type } = Astro.props;
---

<div class="border-b border-muted py-4 prose-p:my-0">
  <div class="not-prose flex flex-wrap items-center gap-2 text-xs">
    <span class="font-mono text-sm font-medium text-foreground">{name}</span>
    <span class="font-mono text-muted-foreground">{type}</span>
  </div>
  <div class="pt-2 text-sm/6 text-muted-foreground">
    <slot />
  </div>
</div>
