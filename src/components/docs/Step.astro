---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div role="listitem" class="group relative flex gap-4 pb-8 last:pb-0">
  <span class="absolute top-9 bottom-1 left-3.5 border-l border-muted group-last:hidden" aria-hidden="true"></span>
  <span
    class="flex size-7 shrink-0 items-center justify-center rounded-full border border-muted bg-surface font-mono text-xs font-medium text-foreground"
    aria-hidden="true"
    data-step-number
  ></span>
  <div class="min-w-0 flex-1 prose-p:my-2 prose-pre:my-0">
    <p class="not-prose pt-0.5 text-base font-medium text-foreground">{title}</p>
    <slot />
  </div>
</div>
