---
interface Props {
  variant?: "muted" | "accent" | "danger" | "outline";
  class?: string;
}

const { variant = "muted", class: className } = Astro.props;
const variants = {
  muted: "bg-muted text-foreground",
  accent: "bg-accent/20 text-foreground",
  danger: "bg-danger/10 text-danger",
  outline: "border border-muted text-muted-foreground",
};
---

<span class:list={["not-prose inline-flex h-6 items-center rounded-md px-2 font-mono text-xs font-medium", variants[variant], className]}>
  <slot />
</span>
