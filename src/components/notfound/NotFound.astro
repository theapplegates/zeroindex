---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Components
import SearchButton from "@/components/global/SearchButton.astro";
---

<section>
  <Wrapper variant="standard" class="py-24">
    <div class="mx-auto flex max-w-xl flex-col items-center text-center">
      <Text tag="h1" variant="displayLG" class="font-semibold tracking-tight text-pretty lg:text-balance">Page not found</Text>
      <Text tag="p" variant="textLG" class="mt-4 text-pretty text-muted-foreground">
        The link may be old, or the page moved when the blog was reorganised. Search for it, or start from the archive.
      </Text>
      <div class="mt-10 w-full">
        <SearchButton size="lg" />
      </div>
      <Button isLink={true} href="/posts" size="lg" variant="primary" class="mt-6">
        Back to all posts
      </Button>
    </div>
  </Wrapper>
</section>
