# Cloudinary: used for post covers and inline images.
PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Assistant: Google AI Studio key for Gemini Embedding 2 and Gemma 4.
# Without it the assistant still answers, using plain term search over the posts.
GEMINI_API_KEY=

# Optional overrides.
ASSISTANT_CHAT_MODEL=gemma-4-26b-a4b-it
ASSISTANT_EMBEDDING_MODEL=gemini-embedding-2
